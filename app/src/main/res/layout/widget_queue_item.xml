<?xml version="1.0" encoding="utf-8"?>
<!-- One row in the queue widget. Tap it to jump. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="2dp"
    android:paddingEnd="2dp">

    <TextView
        android:id="@+id/row_index"
        android:layout_width="20dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:textSize="10sp"
        android:textColor="#A8A2B4"
        android:maxLines="1"
        android:text="1" />

    <ImageView
        android:id="@+id/row_art"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textSize="12.5sp"
            android:textColor="#F4F1E9"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Title" />

        <TextView
            android:id="@+id/row_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textSize="10.5sp"
            android:textColor="#A8A2B4"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Artist" />
    </LinearLayout>

    <TextView
        android:id="@+id/row_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:textSize="10sp"
        android:textColor="#A8A2B4"
        android:text="0:00" />
</LinearLayout>
