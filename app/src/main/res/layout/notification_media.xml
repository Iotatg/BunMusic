<?xml version="1.0" encoding="utf-8"?>
<!--
  Expanded notification.

  RemoteViews, so: only framework widgets, no custom fonts, no theme
  attributes (the system inflates this with its own theme, and `?attr/colorPrimary`
  resolves to something unrelated). Every colour is literal on purpose.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notif_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notif_art"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:contentDescription="Album art"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F4F1E9"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#A39FAE"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/notif_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="10dp"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/notif_progress" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_elapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#6E6A78"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/notif_remaining"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="#6E6A78"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/notif_like"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Like"
            android:scaleType="centerInside"
            android:src="@drawable/ic_n_heart" />

        <ImageButton
            android:id="@+id/notif_prev"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Previous"
            android:scaleType="centerInside"
            android:src="@drawable/ic_w_prev" />

        <ImageButton
            android:id="@+id/notif_toggle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.2"
            android:background="@android:color/transparent"
            android:contentDescription="Play or pause"
            android:scaleType="centerInside"
            android:src="@drawable/ic_w_play" />

        <ImageButton
            android:id="@+id/notif_next"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Next"
            android:scaleType="centerInside"
            android:src="@drawable/ic_w_next" />

        <ImageButton
            android:id="@+id/notif_shuffle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Shuffle"
            android:scaleType="centerInside"
            android:src="@drawable/ic_n_shuffle" />

        <ImageButton
            android:id="@+id/notif_repeat"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Repeat"
            android:scaleType="centerInside"
            android:src="@drawable/ic_n_repeat_off" />
    </LinearLayout>
</LinearLayout>
