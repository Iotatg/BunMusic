<?xml version="1.0" encoding="utf-8"?>
<!--
  4x2 now-playing card. Everything is sized by weights or fixed dp that the
  renderer can hide: on a launcher whose cells are shorter than 130 dp the time
  row is dropped rather than clipped, and on a narrow cell the like and queue
  buttons go away. See WidgetRenderer.density().
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_midnight_round"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="9dp"
    android:paddingBottom="7dp">

    <LinearLayout
        android:id="@+id/widget_top"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="46dp"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textSize="13.5sp"
                android:textColor="#F4F1E9"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="BunMusic" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif"
                android:textSize="11sp"
                android:textColor="#A8A2B4"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Nothing playing" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_progress"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="7dp"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/widget_times"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_elapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textSize="9.5sp"
            android:textColor="#A8A2B4"
            android:text="0:00" />

        <TextView
            android:id="@+id/widget_duration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:fontFamily="sans-serif"
            android:textSize="9.5sp"
            android:textColor="#A8A2B4"
            android:text="0:00" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_controls"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_like"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="9dp"
            android:src="@drawable/ic_w_heart"
            android:contentDescription="Like" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <ImageView
            android:id="@+id/widget_prev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_w_prev"
            android:contentDescription="Previous" />

        <ImageView
            android:id="@+id/widget_toggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:padding="11dp"
            android:background="@drawable/widget_play_midnight"
            android:src="@drawable/ic_w_play"
            android:contentDescription="Play or pause" />

        <ImageView
            android:id="@+id/widget_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_w_next"
            android:contentDescription="Next" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <ImageView
            android:id="@+id/widget_queue"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="9dp"
            android:src="@drawable/ic_w_queue"
            android:contentDescription="Open queue" />
    </LinearLayout>
</LinearLayout>
