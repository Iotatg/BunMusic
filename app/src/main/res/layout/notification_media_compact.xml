<?xml version="1.0" encoding="utf-8"?>
<!--
  Collapsed notification: artwork, two lines, a hairline of progress and one
  button. The queue controls live in the expanded view — a collapsed media row
  has room for one decision, and that decision is play/pause.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notif_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/notif_art"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="Album art"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F4F1E9"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#A39FAE"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/notif_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="5dp"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/notif_progress" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/notif_toggle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="6dp"
        android:background="@android:color/transparent"
        android:contentDescription="Play or pause"
        android:scaleType="centerInside"
        android:src="@drawable/ic_w_play" />
</LinearLayout>
