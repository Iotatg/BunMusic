<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BunMusic" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#08070B</item>
        <item name="android:navigationBarColor">#08070B</item>
        <item name="android:windowBackground">#08070B</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Android 12+ draws its own splash from the app icon. Point it at the
             foreground layer so the bun sits on the void instead of a white card. -->
        <item name="android:windowSplashScreenBackground">#08070B</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
    </style>

    <style name="Theme.BunMusic.Light" parent="Theme.BunMusic">
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_charcoal_foreground</item>
    </style>

    <!-- Cloud's splash: the bun in headphones on the chalk page, not the black
         disc on white that it would otherwise inherit from Light. -->
    <style name="Theme.BunMusic.Cloud" parent="Theme.BunMusic.Light">
        <item name="android:statusBarColor">#F6F8FD</item>
        <item name="android:navigationBarColor">#F6F8FD</item>
        <item name="android:windowBackground">#F6F8FD</item>
        <item name="android:windowSplashScreenBackground">#F6F8FD</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_cloud_foreground</item>
    </style>
</resources>
