<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn, not tinted: a layer-list with an explicit progress layer survives
     being inflated in the system's process, where theme tints are not ours. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#2A2634" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="#D8F65C" />
                <corners android:radius="2dp" />
            </shape>
        </clip>
    </item>
</layer-list>
