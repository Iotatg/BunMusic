<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud's backdrop is the page the bun is drawn on: chalk white with the
     faintest blue at the rim, so the blue disc inside does not float on nothing.
     The foreground layer carries its own white plate, so this only shows at the
     very edge of a mask that crops harder than the artwork does. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="50"
                android:gradientRadius="88">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="0.70" android:color="#FFFFFFFF" />
                <item android:offset="1.0" android:color="#FFEDF3FF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
