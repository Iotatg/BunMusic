<?xml version="1.0" encoding="utf-8"?>
<!-- Charcoal's backdrop is the paper the art is drawn on: flat white, with a
     whisper of warm grey at the corners so the disc does not float on nothing.
     The foreground layer is opaque, so this only ever shows through at the very
     edge of a mask that crops harder than the artwork does. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="50"
                android:gradientRadius="86">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="0.72" android:color="#FFFFFFFF" />
                <item android:offset="1.0" android:color="#FFF7F5F2" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
